DATABASE_URL=sqlite:///storage/argus.db
STORAGE_DIR=storage
ADMIN_USERNAME=admin
# Set a unique password (12+ characters), or leave blank for interactive setup.
ADMIN_PASSWORD=
MODEL_PATH=storage/models/yolo11n.pt
# auto = CUDA, then Apple MPS, then CPU. Use cpu, cuda, cuda:0 or mps to force a device.
DEVICE=auto
# Required only for Docker Compose (PostgreSQL/PostGIS).
POSTGRES_PASSWORD=
UPLOAD_LIMIT_MB=1024
SESSION_HOURS=8
COOKIE_SECURE=false
DEMO_ENABLED=true
